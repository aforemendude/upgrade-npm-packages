{
  "author": "aforemendude",
  "bin": {
    "upgrade-npm-packages": "./dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/aforemendude/upgrade-npm-packages/issues"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "npm-package-arg": "14.0.0",
    "semver": "7.8.5"
  },
  "description": "A CLI tool that recursively upgrades npm package dependencies to the latest eligible versions.",
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "@types/npm-package-arg": "6.1.4",
    "@types/semver": "7.7.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=22.12.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js"
  ],
  "homepage": "https://github.com/aforemendude/upgrade-npm-packages",
  "keywords": [
    "npm",
    "packages",
    "dependencies",
    "package-json",
    "cli"
  ],
  "license": "MIT",
  "name": "@aforemendude/upgrade-npm-packages",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aforemendude/upgrade-npm-packages.git"
  },
  "scripts": {
    "build": "npm run clean && tsc && node scripts/set-bin-executable.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write --cache --cache-strategy metadata .",
    "format:check": "prettier --check --cache --cache-strategy metadata .",
    "format:nocache": "prettier --write .",
    "prepack": "npm install && git diff --exit-code -- package-lock.json && npm run verify",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "prettier --check . && npm run build && npm run test"
  },
  "version": "4.0.1"
}
